# =============================================================================
# Salin file ini menjadi `.env` (tidak ikut ter-commit) dan isi sesuai target uji.
# Repo ini publik: TIDAK ada host, akun, atau nama aplikasi nyata yang disimpan
# di dalam kode. Tanpa TEST_BASE_URL, suite web di-SKIP dengan pesan jelas —
# bukan diam-diam menghantam host acak.
# =============================================================================

# --- Suite WEB (Playwright) --------------------------------------------------

# Base URL situs yang diuji. WAJIB untuk semua suite web.
TEST_BASE_URL=https://situs-uji.example

# Dashboard agen bila terpisah dari situs publik (SPA sendiri).
# Default: TEST_BASE_URL.
TEST_AGENT_DASHBOARD_URL=https://agen.situs-uji.example/

# Halaman registrasi agen. Default: $TEST_BASE_URL/agent/agentregistration
TEST_REGISTRATION_URL=https://situs-uji.example/agent/agentregistration

# Bentuk form login: 'modal' (form di dalam modal, dibuka dari menu profil) atau
# 'page' (form berdiri sendiri di /agent/login). Kosongkan untuk auto-detect dari
# hostname: mengandung dev/staging/uat/localhost → 'page', selain itu → 'modal'.
TEST_LOGIN_MODE=

# Label UI yang mengandung merek — dijauhkan dari kode agar repo tetap netral.
TEST_LABEL_TAB_AGEN=Agen
TEST_LABEL_MENU_PROFIL=Menu Profil
TEST_LABEL_SUMBER_INFORMASI=Media Sosial

# Kredensial agen. Tanpa ini, suite yang butuh login di-SKIP (bukan gagal palsu).
# JANGAN pernah commit nilai sebenarnya.
TEST_AGENT_USERNAME=
TEST_AGENT_PASSWORD=

# Berkas storageState sesi agen. Default: playwright/.auth/agen.json
# Dibuat oleh `npm run auth:agen` (login sekali headed, lolos reCAPTCHA), lalu
# dipakai spec pasca-login supaya bisa jalan HEADLESS. Berisi token sesi nyata:
# tidak pernah di-commit. Di CI, isinya datang dari secret AGENT_STORAGE_STATE_B64
# (`npm run sesi:base64` untuk mencetak nilainya).
TEST_AGENT_STORAGE_STATE=

# Pola ID listing platform (regex) untuk memungut ID hasil submit dari UI.
# Default: \b\d{6}-[A-Z]{2,6}\d{3,7}\b  (mis. 131226-ABC00007)
TEST_LISTING_ID_PATTERN=

# Pakai Chrome asli (bukan Chromium bundled) untuk flow ber-reCAPTCHA.
USE_CHROME_CHANNEL=

# Opt-in menjalankan spec yang digerbangi reCAPTCHA di CI (dijalankan headed).
FORCE_RUN_RECAPTCHA=

# --- Suite MOBILE NATIVE (mobilewright) --------------------------------------

# applicationId APK yang diuji. Cek: adb shell pm list packages
MOBILE_APP_PACKAGE=com.example.propertyapp

# Path APK yang di-install ulang tiap run. APK tidak disertakan di repo.
MOBILE_APK_PATH=./app-under-test.apk

# Regex nama device seperti yang DILAPORKAN mobilecli (`mobilecli devices`),
# BUKAN nama AVD. Emulator biasanya melaporkan model, mis. sdk_gphone.
MOBILE_DEVICE_NAME=sdk_gphone

# Opt-in TC yang benar-benar SUBMIT (membuat data nyata di lingkungan target).
RUN_BUAT_LISTING_SUBMIT=
