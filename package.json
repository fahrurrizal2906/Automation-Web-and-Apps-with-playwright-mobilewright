{
  "name": "portofolio-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Portofolio otomasi QA: Playwright (web) + mobilewright (Android native), dengan Allure report",
  "type": "commonjs",
  "scripts": {
    "test": "node scripts/jalankan.mjs --project=chromium",
    "test:login-negatif": "node scripts/jalankan.mjs test/web/agent-login-negative.spec.ts --project=chromium",
    "test:registrasi": "node scripts/jalankan.mjs test/web/registrasi.spec.ts --project=chromium --headed",
    "test:registrasi-form": "node scripts/jalankan.mjs test/web/registrasi-form.spec.ts --project=chromium",
    "test:buat-listing": "node scripts/jalankan.mjs test/web/buat-listing.spec.ts --project=chromium --headed",
    "test:ci": "playwright test --project=chromium --reporter=line,allure-playwright",
    "mobile:test": "node scripts/jalankan.mjs --mobile",
    "mobile:test:login-negatif": "node scripts/jalankan.mjs --mobile test-mobile-native/login-agen-negatif.test.ts",
    "mobile:test:buat-listing": "node scripts/jalankan.mjs --mobile test-mobile-native/buat-listing.test.ts",
    "mobile:devices": "mobilewright devices",
    "mobile:doctor": "mobilewright doctor",
    "fixtures": "node scripts/buat-fixture.mjs",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "audit:sanitasi": "node scripts/audit-sanitasi.mjs",
    "auth:agen": "playwright test --project=setup",
    "sesi:base64": "node scripts/sesi-agen.mjs ke-base64",
    "sesi:pulihkan": "node scripts/sesi-agen.mjs dari-base64"
  },
  "keywords": [
    "playwright",
    "mobilewright",
    "qa-automation",
    "allure",
    "typescript",
    "android"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "dotenv": "^17.4.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@mobilewright/test": "0.0.44",
    "mobilewright": "0.0.44"
  },
  "overrides": {
    "@playwright/test": "1.59.1",
    "playwright": "1.59.1",
    "playwright-core": "1.59.1"
  }
}
